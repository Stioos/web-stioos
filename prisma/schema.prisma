// ============================================================
// STIOOS GLOBAL — Production Prisma Schema
// Designed for PostgreSQL + 200K concurrent users
// ============================================================
// Scaling notes:
//   - All hot-path columns indexed (email, slug, status, buyerId)
//   - Composite indexes on common filter patterns
//   - Foreign keys with cascade/restrict rules
//   - JSON columns for flexible metadata (PostgreSQL native)
//   - Timestamps on every row for audit + pagination
//   - Soft-delete via status enum (never hard-delete)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
  // For production PostgreSQL, change to:
  // provider = "postgresql"
  // url      = env("DATABASE_URL") // postgresql://user:pass@host:5432/stioos
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String
  name             String
  company          String           @default("")
  phone            String           @default("")
  country          String           @default("")
  status           String           @default("active") // active | inactive | suspended
  role             String           @default("buyer") // buyer | member
  // Buyer registration fields
  registrationType String?          // professional | company
  accountType      String?
  profession       String?
  companySize      String?
  phoneCountry     String?
  intent           String?
  intentTimeline   String?
  registrationSource String?
  // Relations
  requests         MarketRequest[]
  orders           MarketOrder[]
  threads          MarketThread[]
  transactions     Transaction[]
  quotes           Quote[]          @relation("QuoteBuyer")
  invoices         Invoice[]        @relation("InvoiceBuyer")
  wishlist         WishlistItem[]
  sessions         Session[]
  // Timestamps
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lastActive       DateTime         @default(now())

  @@index([email])
  @@index([status])
  @@index([role])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String   @unique
  expiresAt    DateTime
  ip           String?
  userAgent    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model AdminUser {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  phone          String   @default("")
  roleId         String
  title          String   @default("")
  status         String   @default("active") // active | inactive
  avatarInitials String?
  role           Role     @relation(fields: [roleId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastActive     DateTime @default(now())

  @@index([email])
  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  permissions String   @default("{}") // JSON: Record<ModuleKey, PermissionAction[]>
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  admins      AdminUser[]
}

model WishlistItem {
  id          String   @id @default(cuid())
  userId      String
  serviceSlug String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, serviceSlug])
  @@index([userId])
}

// ============================================================
// CATALOG — Categories, Subcategories, Services
// ============================================================

model Category {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  icon        String        @default("FolderTree")
  tagline     String        @default("")
  description String        @default("")
  status      String        @default("active") // active | disabled
  featured    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  subcategories Subcategory[]
  services    Service[]

  @@index([slug])
  @@index([status])
}

model Subcategory {
  id          String   @id @default(cuid())
  name        String
  slug        String
  categoryId  String
  description String   @default("")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  services    Service[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([slug])
}

model Service {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  categoryId       String
  subcategoryId    String
  shortDescription String      @default("")
  fullDescription  String      @default("")
  tags             String      @default("[]") // JSON array
  industries       String      @default("[]") // JSON array
  deliveryType     String      @default("project") // project | subscription | retainer | on_demand | self_serve
  timeline         String      @default("")
  rating           Float       @default(0)
  reviews          Int         @default(0)
  popularity       Int         @default(0)
  featured         Boolean     @default(false)
  status           String      @default("published") // draft | published | archived
  accent           String      @default("from-slate-600 to-slate-800")
  icon             String      @default("Package")
  problemsSolved   String      @default("[]") // JSON array
  capabilities     String      @default("[]") // JSON array
  deliverables     String      @default("[]") // JSON array
  process          String      @default("[]") // JSON array of {title, description}
  technologies     String      @default("[]") // JSON array
  faqs             String      @default("[]") // JSON array of {question, answer}
  metaTitle        String?
  metaDescription  String?
  createdBy        String      @default("system")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  category         Category    @relation(fields: [categoryId], references: [id])
  subcategory      Subcategory @relation(fields: [subcategoryId], references: [id])

  @@index([slug])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
  @@index([featured])
}

// ============================================================
// ENGAGEMENT — Requests, Quotes, Orders, Invoices, Transactions
// ============================================================

model MarketRequest {
  id             String     @id @default(cuid())
  reference      String     @unique // REQ-XXXXX
  buyerId        String
  buyerName      String
  buyerCompany   String     @default("")
  categoryId     String
  categoryName   String
  title          String
  details        String
  budgetRange    String     @default("")
  timeline       String     @default("")
  status         String     @default("open") // open | in_review | quoted | approved | ordered | paid | delivered | closed | rejected
  kind           String     @default("service") // service | train-to-hire | hire-to-train | talent-sourcing | end-to-end-staffing | post-a-job
  meta           String     @default("{}") // JSON: structured form answers
  declineReason  String?
  quotedAmount   Float?
  statusHistory  String     @default("[]") // JSON: [{status, note, at, by}]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  buyer          User       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  order          MarketOrder?
  quote          Quote?
  invoice        Invoice?

  @@index([buyerId])
  @@index([status])
  @@index([kind])
  @@index([reference])
  @@index([createdAt])
}

model Quote {
  id              String   @id @default(cuid())
  reference       String   @unique // QUO-XXXXX
  requestId       String   @unique
  requestReference String?
  buyerId         String
  buyerName       String
  buyerCompany    String   @default("")
  issuedById      String
  issuedByName    String
  items           String   @default("[]") // JSON: [{id, description, quantity, unitPrice, amount}]
  subtotal        Float    @default(0)
  taxRate         Float    @default(0)
  taxAmount       Float    @default(0)
  discount        Float    @default(0)
  total           Float    @default(0)
  validityDays    Int      @default(14)
  validUntil      DateTime
  notes           String?
  status          String   @default("sent") // draft | sent | accepted | declined | expired
  declineReason   String?
  declinedAt      DateTime?
  acceptedAt      DateTime?
  issuedAt        DateTime @default(now())
  buyer           User     @relation("QuoteBuyer", fields: [buyerId], references: [id])
  request         MarketRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  invoice         Invoice?

  @@index([buyerId])
  @@index([status])
  @@index([reference])
  @@index([requestId])
}

model MarketOrder {
  id            String   @id @default(cuid())
  serviceId     String
  serviceSlug   String
  serviceName   String
  serviceIcon   String   @default("Package")
  buyerId       String
  buyerName     String
  buyerCompany   String   @default("")
  amount        Float
  status        String   @default("pending") // pending | in_progress | delivered | completed | cancelled
  deliveryType  String   @default("project")
  requirements  String?
  requestId     String?  @unique
  placedAt      DateTime @default(now())
  updatedAt     DateTime @default(now())
  buyer         User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  request       MarketRequest? @relation(fields: [requestId], references: [id])
  invoice       Invoice?

  @@index([buyerId])
  @@index([status])
  @@index([serviceSlug])
  @@index([placedAt])
}

model Invoice {
  id               String   @id @default(cuid())
  reference        String   @unique // INV-XXXXX
  orderId          String   @unique
  requestId        String?  @unique
  quoteId          String?  @unique
  buyerId          String
  buyerName        String
  buyerCompany     String   @default("")
  issuedById       String
  issuedByName     String
  items            String   @default("[]") // JSON
  subtotal         Float    @default(0)
  taxRate          Float    @default(0)
  taxAmount        Float    @default(0)
  discount         Float    @default(0)
  total            Float    @default(0)
  status           String   @default("issued") // draft | issued | paid | void | refunded
  paidAt           DateTime?
  paymentMethod    String?  // card | bank_transfer | upi | wallet | manual
  paymentReference String?
  notes            String?
  dueDate          DateTime
  issuedAt         DateTime @default(now())
  buyer            User     @relation("InvoiceBuyer", fields: [buyerId], references: [id])
  order            MarketOrder @relation(fields: [orderId], references: [id])
  request          MarketRequest? @relation(fields: [requestId], references: [id])
  quote            Quote?   @relation(fields: [quoteId], references: [id])
  transactions     Transaction[]

  @@index([buyerId])
  @@index([status])
  @@index([reference])
  @@index([orderId])
}

model Transaction {
  id               String   @id @default(cuid())
  reference        String   @unique // TXN-XXXXX
  type             String   // payment | refund | credit | debit | adjustment
  invoiceId        String?
  orderId          String?
  requestId        String?
  quoteId          String?
  buyerId          String
  buyerName        String
  buyerCompany     String   @default("")
  amount           Float
  currency         String   @default("USD")
  method           String   @default("manual") // card | bank_transfer | upi | wallet | manual
  status           String   @default("success") // pending | success | failed | refunded
  description      String   @default("")
  initiatedById    String
  initiatedByName  String
  gatewayReference String?
  meta             String   @default("{}") // JSON
  createdAt        DateTime @default(now())
  buyer            User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  invoice          Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([buyerId])
  @@index([type])
  @@index([status])
  @@index([reference])
  @@index([invoiceId])
  @@index([createdAt])
}

// ============================================================
// MESSAGING — Threads, Messages, Inquiries
// ============================================================

model MarketThread {
  id            String   @id @default(cuid())
  serviceId     String
  serviceSlug   String
  serviceName   String
  serviceIcon   String   @default("Package")
  buyerId       String
  buyerName     String
  teamId        String   @default("team-stioos")
  teamName      String   @default("STIOOS Delivery Team")
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  buyer         User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  messages      MarketMessage[]

  @@index([buyerId])
  @@index([serviceSlug])
}

model MarketMessage {
  id         String   @id @default(cuid())
  threadId   String
  senderId   String
  senderName String
  senderRole String   // buyer | team
  body       String
  sentAt     DateTime @default(now())
  thread     MarketThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([sentAt])
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String   @default("")
  phone       String   @default("")
  type        String   @default("contact") // quote | service_request | contact | consultation
  serviceId   String?
  serviceName String?
  requirements String  @default("")
  budgetRange String   @default("")
  timeline    String   @default("")
  status      String   @default("new") // new | in_progress | contacted | closed
  userId      String?
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([type])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================
// CONTENT — Insights, Resources, FAQs, Industries
// ============================================================

model Insight {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String   @default("")
  excerpt     String   @default("")
  content     String   @default("")
  author      String   @default("")
  readTime    String   @default("5 min")
  publishedAt DateTime @default(now())
  status      String   @default("published")
  accent      String   @default("from-slate-600 to-slate-800")

  @@index([slug])
  @@index([status])
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  type        String   @default("guide") // guide | whitepaper | checklist | case_study | template
  description String   @default("")
  fileFormat  String   @default("PDF")
  size        String   @default("2.4 MB")
  downloads   Int      @default(0)
  publishedAt DateTime @default(now())
  status      String   @default("published")
  accent      String   @default("from-slate-600 to-slate-800")

  @@index([slug])
  @@index([status])
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General")
  status    String   @default("published")
  order     Int      @default(0)

  @@index([status])
  @@index([category])
}

model Industry {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  icon          String   @default("Building2")
  description   String   @default("")
  servicesCount Int      @default(0)
  status        String   @default("active")

  @@index([slug])
}

// ============================================================
// SYSTEM — Notifications, Activity Logs, Settings
// ============================================================

model AppNotification {
  id        String   @id @default(cuid())
  type      String   @default("system") // service_request | contact_inquiry | admin_created | service_published | content_updated | system
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  actor       String   @default("system")
  action      String   // created | updated | deleted | signed in | etc.
  module      String
  target      String
  description String   @default("")
  createdAt   DateTime @default(now())

  @@index([module])
  @@index([createdAt])
}

model HomepageContent {
  id              String   @id @default("1")
  heroBadge       String   @default("")
  heroTitleTop    String   @default("")
  heroTitleBottom String   @default("")
  heroSubtitle    String   @default("")
  primaryCta      String   @default("")
  secondaryCta    String   @default("")
  stats           String   @default("[]") // JSON array
  finalCtaTitle   String   @default("")
  finalCtaSubtitle String  @default("")
}

model BrandSettings {
  id           String   @id @default("1")
  siteName     String   @default("STIOOS Global")
  tagline      String   @default("")
  supportEmail String   @default("support@stioos.com")
  salesEmail   String   @default("sales@stioos.com")
  phone        String   @default("")
  address      String   @default("")
}

model MarketplaceSettings {
  id                    String   @id @default("1")
  status                String   @default("live")
  defaultSort           String   @default("popularity")
  autoApproveServices   Boolean  @default(false)
  featuredSlots         Int      @default(12)
  heroCtaPrimary        String   @default("Get a Quote")
  heroCtaSecondary      String   @default("Schedule Consultation")
  cardCtaPrimary        String   @default("Request Service")
  cardCtaSecondary      String   @default("Contact")
  requireLeadRegistration Boolean @default(true)
}
